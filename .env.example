# Copy to .env. Never commit .env.

TZ=Australia/Melbourne

# Internal DNS names
AI_FQDN=ai.home.arpa
AUTH_FQDN=auth.home.arpa

# Bind to the AI VM LAN address rather than all addresses when practical.
TRAEFIK_BIND_IP=192.168.1.40

# Image tags: replace with release tags tested in your environment.
TRAEFIK_IMAGE=traefik:v3.5
OLLAMA_IMAGE=ollama/ollama:0.32.3
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.10.1
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2026.5.4
POSTGRES_IMAGE=postgres:17-alpine

# PostgreSQL
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
OPENWEBUI_DB_NAME=openwebui
OPENWEBUI_DB_USER=openwebui
OPENWEBUI_DB_PASSWORD=CHANGE_ME
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=CHANGE_ME

# Authentik
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.invalid

# Open WebUI
WEBUI_SECRET_KEY=CHANGE_ME
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=CHANGE_AFTER_CREATING_AUTHENTIK_PROVIDER
OPENID_PROVIDER_URL=https://auth.home.arpa/application/o/open-webui/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://ai.home.arpa/oauth/oidc/callback
OAUTH_PROVIDER_NAME=Authentik

# Backups
RESTIC_REPOSITORY=/mnt/synology-backups/local-ai
RESTIC_PASSWORD=CHANGE_ME
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=5
BACKUP_RETENTION_MONTHLY=12
